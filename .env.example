# ── Servidor ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001

# ── Banco de dados ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://usuario:senha@localhost:5432/clinicai
POSTGRES_USER=usuario
POSTGRES_PASSWORD=senha
POSTGRES_DB=clinicai

# ── Evolution API ──────────────────────────────────────────────────────────────
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=changeme

# ── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o

# ── Anthropic / Claude (opcional) ─────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-4-6

# ── Groq (transcrição de áudio) ────────────────────────────────────────────────
GROQ_API_KEY=gsk_...

# ── Google Calendar OAuth2 ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/admin/google/callback

# ── Evolution store (bind-mount para resolução @lid) ──────────────────────────
# Caminho local onde a Evolution persiste mensagens (ver docker-compose.yml)
EVOLUTION_STORE_PATH=./.evolution-store
# Token incluído na URL do webhook (/webhook/:instance?token=SECRET) para autenticar chamadas da Evolution
EVOLUTION_WEBHOOK_SECRET=

# ── Admin / JWT ────────────────────────────────────────────────────────────────
ADMIN_SECRET=troque-por-uma-chave-segura
JWT_SECRET=troque-por-uma-chave-segura
TRIAL_DAYS=3

# ── Mercado Pago ──────────────────────────────────────────────────────────────
MP_ACCESS_TOKEN=APP_USR-...
# Obtido em mercadopago.com → Suas integrações → Webhooks → Segredo do webhook
MP_WEBHOOK_SECRET=

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
FROM_EMAIL=noreply@seudominio.com

# ── Frontend ───────────────────────────────────────────────────────────────────
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
